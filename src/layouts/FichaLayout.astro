---
// Plantilla de ficha (Patrón 5): cabecera + contenido + bloques generados.
// Los bloques «Relacionados» y «Mencionado en» se generan aquí desde el
// frontmatter y los backlinks; no se escriben en el cuerpo (RF-06).
import BaseLayout from "./BaseLayout.astro";
import Badge from "../components/Badge.astro";
import Relacionados from "../components/Relacionados.astro";
import MencionadoEn from "../components/MencionadoEn.astro";

interface Props {
  titulo: string;
  resumen: string;
  categoria: string;
  tags: string[];
  slug: string;
  coleccion: string;
  urlColeccion: string;
  nombreColeccion: string;
}

const {
  titulo,
  resumen,
  categoria,
  tags,
  slug,
  coleccion,
  urlColeccion,
  nombreColeccion,
} = Astro.props;

const base = import.meta.env.BASE_URL;

const colorColeccion =
  coleccion === "glosario"
    ? "text-[var(--color-accent-text)]"
    : coleccion === "tecnologias"
      ? "text-[var(--color-dev-text)]"
      : "text-[var(--color-design-text)]";
---

<BaseLayout titulo={titulo} descripcion={resumen}>
  <div class="max-w-4xl mx-auto">
    <!-- Migas de pan (Breadcrumbs) -->
    <nav
      aria-label="Ruta de navegación"
      class="text-xs sm:text-sm text-[var(--color-muted-text)] mb-6"
    >
      <ol class="flex flex-wrap items-center gap-1.5 list-none p-0 m-0">
        <li>
          <a
            href={base}
            class="no-underline text-[var(--color-muted-text)] hover:text-[var(--color-text)] transition-colors"
          >
            Inicio
          </a>
        </li>
        <li aria-hidden="true" class="text-[var(--color-border-strong)]">
          /
        </li>
        <li>
          <a
            href={urlColeccion}
            class="no-underline text-[var(--color-muted-text)] hover:text-[var(--color-text)] transition-colors"
          >
            {nombreColeccion}
          </a>
        </li>
        <li aria-hidden="true" class="text-[var(--color-border-strong)]">
          /
        </li>
        <li aria-current="page" class="font-medium text-[var(--color-text)]">
          {titulo}
        </li>
      </ol>
    </nav>

    <!-- Cabecera de la ficha sin recuadro exterior -->
    <header class="pb-6 mb-8">
      <div class="flex items-center gap-2 mb-3">
        <span
          class={`font-mono text-xs uppercase tracking-wider font-bold ${colorColeccion}`}
        >
          {nombreColeccion}
        </span>
        <span class="text-[var(--color-border-strong)]">·</span>
        <Badge tipo="categoria">{categoria}</Badge>
      </div>

      <h1 class="text-2xl sm:text-3xl md:text-4xl font-extrabold tracking-tight text-[var(--color-text)] m-0 mb-3">
        {titulo}
      </h1>

      <p class="text-sm sm:text-base text-[var(--color-muted-text)] leading-relaxed m-0 mb-5">
        {resumen}
      </p>

      {tags && tags.length > 0 && (
        <div class="flex flex-wrap items-center gap-2 pt-3 border-t border-[var(--color-border)]/60">
          <span class="text-xs text-[var(--color-muted)] mr-1">Etiquetas:</span>
          {tags.map((tag) => (
            <Badge tipo="tag">{tag}</Badge>
          ))}
        </div>
      )}
    </header>

    <!-- Contenido Markdown en un recuadro (superficie + borde + esquinas) -->
    <article class="prose prose-wiki mb-12 rounded-[var(--radius-lg)] border border-[var(--color-border)] bg-[var(--color-surface)] p-5 sm:p-8">
      <slot />
    </article>

    <!-- Bloques generados al pie de la ficha: 2 columnas (Relacionados / Mencionado en) -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 pt-8 border-t border-[var(--color-border)]">
      <Relacionados slug={slug} coleccion={coleccion} />
      <MencionadoEn slug={slug} coleccion={coleccion} />
    </div>
  </div>
</BaseLayout>
