---
// Plantilla de ficha (Patrón 5): cabecera + contenido + bloques generados.
// Los bloques «Relacionados» y «Mencionado en» se generan aquí desde el
// frontmatter y los backlinks; no se escriben en el cuerpo (RF-06).
import BaseLayout from "./BaseLayout.astro";
import Badge from "../components/Badge.astro";
import Relacionados from "../components/Relacionados.astro";
import MencionadoEn from "../components/MencionadoEn.astro";

interface Props {
  titulo: string;
  resumen: string;
  categoria: string;
  tags: string[];
  slug: string;
  coleccion: string;
  urlColeccion: string;
  nombreColeccion: string;
}

const {
  titulo,
  resumen,
  categoria,
  tags,
  slug,
  coleccion,
  urlColeccion,
  nombreColeccion,
} = Astro.props;

const base = import.meta.env.BASE_URL;
---

<BaseLayout titulo={titulo} descripcion={resumen}>
  <nav aria-label="Ruta de navegación" class="text-sm text-muted mb-4">
    <ol class="flex flex-wrap gap-2 list-none p-0 m-0">
      <li>
        <a href={base}>Inicio</a>
      </li>
      <li aria-hidden="true">/</li>
      <li>
        <a href={urlColeccion}>{nombreColeccion}</a>
      </li>
      <li aria-hidden="true">/</li>
      <li aria-current="page">{titulo}</li>
    </ol>
  </nav>

  <article class="prose">
    <header>
      <h1>{titulo}</h1>
      <p class="text-muted">{resumen}</p>
      <p class="flex flex-wrap gap-2">
        <Badge tipo="categoria">{categoria}</Badge>
        {tags.map((tag) => (
          <Badge tipo="tag">{tag}</Badge>
        ))}
      </p>
    </header>

    <slot />

    <Relacionados slug={slug} coleccion={coleccion} />
    <MencionadoEn slug={slug} coleccion={coleccion} />
  </article>
</BaseLayout>
