---
import BaseLayout from "./BaseLayout.astro";
import BotonEnlace from "../components/BotonEnlace.astro";

interface Props {
  frontmatter: {
    titulo: string;
    resumen: string;
    apartado: "funcional" | "tecnico";
  };
}

const { frontmatter } = Astro.props;
const base = import.meta.env.BASE_URL;
const esTecnico = frontmatter.apartado === "tecnico";
---

<BaseLayout titulo={frontmatter.titulo} descripcion={frontmatter.resumen}>
  <div class="max-w-4xl mx-auto">
    {esTecnico && (
      <nav aria-label="Navegación entre apartados" class="mb-6">
        <a
          href={`${base}telegrambot`}
          class="text-sm font-medium text-[var(--color-muted-text)] hover:text-[var(--color-text)] no-underline transition-colors"
        >
          ← Apartado funcional
        </a>
      </nav>
    )}

    <header class="pb-6 mb-8 border-b border-[var(--color-border)]">
      <p class="text-xs font-mono uppercase tracking-wider text-[var(--color-muted-text)] mb-3">
        Telegram · Apartado {esTecnico ? "técnico" : "funcional"}
      </p>
      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-[var(--color-text)] m-0 mb-3">
        {frontmatter.titulo}
      </h1>
      <p class="text-base sm:text-lg text-[var(--color-muted-text)] leading-relaxed m-0 text-balance">
        {frontmatter.resumen}
      </p>
    </header>

    <article class="prose prose-wiki mb-8 rounded-[var(--radius-lg)] border border-[var(--color-border)] bg-[var(--color-surface)] p-5 sm:p-8">
      <slot />
    </article>

    {esTecnico ? (
      <div class="flex justify-start">
        <BotonEnlace
          href={`${base}telegrambot`}
          variante="secundaria"
          class="no-underline"
        >
          ← Volver al apartado funcional
        </BotonEnlace>
      </div>
    ) : (
      <aside class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 rounded-[var(--radius-lg)] border border-[var(--color-border)] bg-[var(--color-surface)] p-5 sm:p-6">
        <div>
          <h2 class="text-base font-bold text-[var(--color-text)] m-0">
            ¿Quieres conocer el proceso interno?
          </h2>
          <p class="text-sm text-[var(--color-muted-text)] m-0 mt-1">
            Consulta el apartado técnico y el diagrama del flujo.
          </p>
        </div>
        <BotonEnlace
          href={`${base}telegrambot/tecnico`}
          variante="principal"
          class="shrink-0 no-underline"
        >
          Ver apartado técnico →
        </BotonEnlace>
      </aside>
    )}
  </div>
</BaseLayout>
