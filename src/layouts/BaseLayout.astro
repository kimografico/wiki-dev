---
// Plantilla base (Patrón 5): estructura común, cabecera, pie y metadatos.
import "../styles/global.css";
import InterruptorTema from "../features/preferencias/InterruptorTema.tsx";
import InterruptorSoloPendientes from "../features/preferencias/InterruptorSoloPendientes.tsx";
import { CATALOGO, LISTA_COLECCIONES } from "../lib/content/catalogo.ts";

interface Props {
  titulo: string;
  descripcion?: string;
}

const { titulo, descripcion = "Wiki de consulta para programadores junior." } =
  Astro.props;

const base = import.meta.env.BASE_URL;
// Menú móvil: colecciones del catálogo excepto comparativas.
const coleccionesDesplegable = LISTA_COLECCIONES.filter(
  (c) => c !== "comparativas",
).map((coleccion) => ({
  href: `${base}${coleccion}`,
  texto: CATALOGO[coleccion].nombre,
}));

// Desplegable de escritorio: «Inicio» primero y sin «Glosario».
const desplegableEscritorio = [
  { href: base, texto: "Inicio" },
  ...LISTA_COLECCIONES.filter(
    (c) => c !== "comparativas" && c !== "glosario",
  ).map((coleccion) => ({
    href: `${base}${coleccion}`,
    texto: CATALOGO[coleccion].nombre,
  })),
];

// En escritorio, Glosario va como primer enlace directo, fuera del desplegable.
const hrefGlosario = `${base}glosario`;

// Enlaces fuera del desplegable en el Header (solo Acerca de y TelegramBot, sin Comparativas)
const enlacesHeaderFuera = [
  { href: `${base}acerca-de`, texto: "Acerca de" },
  { href: `${base}telegrambot`, texto: "TelegramBot" },
];

// Enlaces del Footer (Glosario, Comparativas, Acerca de y TelegramBot)
const enlacesFooter = [
  { href: `${base}glosario`, texto: "Glosario" },
  { href: `${base}comparativas`, texto: "Comparativas" },
  { href: `${base}acerca-de`, texto: "Acerca de" },
  { href: `${base}telegrambot`, texto: "TelegramBot" },
];
const rutaActual = Astro.url.pathname;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo} · wiki-dev</title>
    <meta name="description" content={descripcion} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="icon" href={`${base}favicon.ico`} />
    <meta name="color-scheme" content="light dark" />
    <meta
      name="theme-color"
      content="#f4f4f2"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#111110"
      media="(prefers-color-scheme: dark)"
    />

    <!-- Google Fonts: DM Sans y JetBrains Mono oficiales de tokens.css -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400..700;1,9..40,400..700&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <!--
      ASTRO: `is:inline` deja el script tal cual y bloqueante en <head>, de modo
      que tema y preferencias se aplican antes del primer pintado (si no, habría
      un destello). No puede importar módulos: la lógica vive en
      `src/lib/preferencias/` y aquí hay una copia mínima (RF-14: el test de
      coherencia comprueba que ambas versiones coinciden). Presupuesto < 2 KB;
      el resto (botón «Mostrar todo», bfcache) vive en las islas del filtro.
      REACT+VITE: sería un script clásico en index.html, antes del bundle.
      RF-13: `wiki:tema` (light | dark) o la preferencia del sistema.
      RF-14: `wiki:aprendidas` (slugs) y `wiki:solo-pendientes` (true | false).
    -->
    <script is:inline>
      (() => {
        const doc = document.documentElement;

        try {
          const g = localStorage.getItem("wiki:tema");
          const tema =
            g === "light" || g === "dark"
              ? g
              : matchMedia("(prefers-color-scheme: dark)").matches
                ? "dark"
                : "light";
          doc.dataset.theme = tema;
        } catch {
          /* sin storage */
        }

        try {
          const crudo = JSON.parse(
            localStorage.getItem("wiki:aprendidas") ?? "[]",
          );
          const aprendidas = Array.isArray(crudo)
            ? crudo.filter(
                (s) => typeof s === "string" && /^[a-z0-9-]+$/.test(s),
              )
            : [];
          const solo = localStorage.getItem("wiki:solo-pendientes") === "true";
          let css = "";
          if (solo) {
            if (aprendidas.length) {
              css = aprendidas
                .map((s) => `[data-slug="${s}"]{display:none}`)
                .join("");
              const sin = aprendidas
                .map((s) => `:not([data-slug="${s}"])`)
                .join("");
              css += `html[data-filtro="solo-pendientes"] .lista-bloque:not(:has(ul>li${sin})) .vacio-filtro{display:block}`;
              css +=
                'html[data-filtro="solo-pendientes"] .lista-portada>li{display:none}';
              css += `html[data-filtro="solo-pendientes"] .lista-portada>li:nth-child(-n+4 of ${sin}){display:block}`;
            }
          } else {
            css = aprendidas
              .map(
                (s) =>
                  `[data-slug="${s}"] .icono-aprendida{display:inline-flex}` +
                  `.entrada-item[data-slug="${s}"]>a{background:var(--color-bg)}`,
              )
              .join("");
          }
          doc.dataset.filtro = solo ? "solo-pendientes" : "todo";
          let style = document.getElementById("wiki-estilos-pref");
          if (!style) {
            style = document.createElement("style");
            style.id = "wiki-estilos-pref";
            document.head.appendChild(style);
          }
          style.textContent = css;
        } catch {
          /* inválidas: todo visible */
        }
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col antialiased">
    <a class="skip-link" href="#contenido">
      Saltar al contenido
    </a>

    <!-- Top Bar Contract: Zone 1 (Wordmark) — Zone 2 (Nav links) — Zone 3 (Action) -->
    <header class="site-header backdrop-blur-md bg-[var(--color-surface)]/90 border-b border-[var(--color-border)] sticky top-0 z-30 transition-colors">
      <div class="contenedor flex items-center justify-between gap-8 py-3.5">
        <!-- Zone 1: Wordmark -->
        <a
          href={base}
          class="flex items-center gap-1.5 font-bold tracking-tight text-lg no-underline text-[var(--color-text)] hover:opacity-90 shrink-0 group"
        >
          <span class="w-2.5 h-2.5 rounded-full bg-[var(--color-accent)] inline-block transition-transform group-hover:scale-125"></span>
          <span class="text-[var(--color-accent)]">wiki·dev</span>
        </a>

        <!-- Zone 2 & Zone 3 agrupadas y alineadas a la derecha -->
        <div class="flex items-center gap-4 ml-auto">
          <!-- Zone 2: Navigation links -->
          <nav
            aria-label="Secciones principales"
            class="hidden md:flex flex-wrap items-center gap-1.5 text-sm font-medium"
          >
            {/* Glosario: primer enlace del header, fuera del desplegable. */}
            <a
              href={hrefGlosario}
              class={`px-3 py-1.5 rounded-lg text-sm transition-all no-underline ${
                rutaActual.startsWith(hrefGlosario)
                  ? "bg-[var(--color-bg)] text-[var(--color-text)] font-semibold border border-[var(--color-border)]"
                  : "text-[var(--color-muted-text)] hover:text-[var(--color-text)] hover:bg-[var(--color-bg)]/50 border border-transparent"
              }`}
              aria-current={
                rutaActual.startsWith(hrefGlosario) ? "page" : undefined
              }
            >
              Glosario
            </a>

            {/* Desplegable de Secciones */}
            {(() => {
              const algunaSeccionActiva = desplegableEscritorio
                .slice(1)
                .some(({ href }) => rutaActual.startsWith(href));
              return (
                <details class="relative group">
                  <summary
                    class={`px-3 py-1.5 rounded-lg text-sm transition-all no-underline cursor-pointer inline-flex items-center gap-1.5 select-none ${
                      algunaSeccionActiva
                        ? "bg-[var(--color-bg)] text-[var(--color-text)] font-semibold border border-[var(--color-border)]"
                        : "text-[var(--color-muted-text)] hover:text-[var(--color-text)] hover:bg-[var(--color-bg)]/50 border border-transparent"
                    } [&::-webkit-details-marker]:hidden`}
                    aria-label="Menú de secciones"
                  >
                    <span>Secciones</span>
                    <svg
                      class="w-3.5 h-3.5 transition-transform group-open:rotate-180 opacity-70"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                      stroke-width="2.5"
                      aria-hidden="true"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M19 9l-7 7-7-7"
                      />
                    </svg>
                  </summary>

                  <div class="absolute left-0 top-full mt-3.5 w-48 rounded-b-2xl border-x border-b border-[var(--color-border)] bg-[var(--color-surface)] shadow-lg py-1.5 -z-10">
                    <nav
                      aria-label="Secciones del catálogo"
                      class="flex flex-col"
                    >
                      {desplegableEscritorio.map(({ href, texto }) => {
                        const activo =
                          href === base
                            ? rutaActual === base
                            : rutaActual.startsWith(href);
                        return (
                          <a
                            href={href}
                            class={`block w-full px-3 py-1.5 text-sm transition-all no-underline ${
                              activo
                                ? "bg-[var(--color-bg)] text-[var(--color-text)] font-semibold"
                                : "text-[var(--color-muted-text)] hover:text-[var(--color-text)] hover:bg-[var(--color-bg)]/50"
                            }`}
                            aria-current={activo ? "page" : undefined}
                          >
                            {texto}
                          </a>
                        );
                      })}
                    </nav>
                  </div>
                </details>
              );
            })()}

            {/* Enlaces fuera del desplegable */}
            {enlacesHeaderFuera.map(({ href, texto }) => {
              const activo = rutaActual.startsWith(href);
              return (
                <a
                  href={href}
                  class={`px-3 py-1.5 rounded-lg text-sm transition-all no-underline ${
                    activo
                      ? "bg-[var(--color-bg)] text-[var(--color-text)] font-semibold border border-[var(--color-border)]"
                      : "text-[var(--color-muted-text)] hover:text-[var(--color-text)] hover:bg-[var(--color-bg)]/50 border border-transparent"
                  }`}
                  aria-current={activo ? "page" : undefined}
                >
                  {texto}
                </a>
              );
            })}
          </nav>

          <!-- Zone 3: Controles (filtro, tema y menú hamburguesa en móvil) -->
          <div class="flex items-center gap-2 sm:gap-3 shrink-0">
            <!-- ISLA: filtro «todo / solo pendientes» (RF-14), antes del tema. -->
            <InterruptorSoloPendientes client:load />

            <!-- ISLA: el interruptor de tema se hidrata en el cliente (RF-13). -->
            <InterruptorTema client:load />

            <!--
              Menú móvil: `<details>` nativo para abrir/cerrar, sin script propio.
              Se cierra solo al navegar (carga de página). Solo contiene la
              navegación: el resto de controles (filtro y tema) ya están en la
              cabecera, también en móvil.
            -->
            <details class="relative md:hidden">
              <summary class="list-none cursor-pointer inline-flex items-center justify-center w-9 h-9 rounded-lg border border-[var(--color-border)] bg-[var(--color-surface)] text-[var(--color-text)] hover:border-[var(--color-accent)] transition-colors [&::-webkit-details-marker]:hidden">
                <svg
                  class="w-5 h-5"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  aria-hidden="true"
                >
                  <path d="M4 6h16M4 12h16M4 18h16"></path>
                </svg>
                <span class="visually-hidden">Abrir menú de navegación</span>
              </summary>

              <div class="absolute right-0 top-full mt-2 w-56 rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] shadow-lg p-2 z-40">
                <nav
                  aria-label="Secciones principales"
                  class="flex flex-col gap-1"
                >
                  <div class="px-2 py-1 text-[11px] font-semibold uppercase tracking-wider text-[var(--color-muted)]">
                    Secciones
                  </div>
                  {coleccionesDesplegable.map(({ href, texto }) => {
                    const activo = rutaActual.startsWith(href);
                    return (
                      <a
                        href={href}
                        aria-current={activo ? "page" : undefined}
                        class:list={[
                          "px-3 py-1.5 rounded-lg text-sm font-medium no-underline transition-colors pl-4",
                          activo
                            ? "bg-[var(--color-bg)] text-[var(--color-text)] border border-[var(--color-border)] font-semibold"
                            : "text-[var(--color-muted-text)] hover:text-[var(--color-text)] hover:bg-[var(--color-bg)]/50 border border-transparent",
                        ]}
                      >
                        {texto}
                      </a>
                    );
                  })}

                  <div class="my-1 border-t border-[var(--color-border)]"></div>

                  {enlacesHeaderFuera.map(({ href, texto }) => {
                    const activo = rutaActual.startsWith(href);
                    return (
                      <a
                        href={href}
                        aria-current={activo ? "page" : undefined}
                        class:list={[
                          "px-3 py-1.5 rounded-lg text-sm font-medium no-underline transition-colors",
                          activo
                            ? "bg-[var(--color-bg)] text-[var(--color-text)] border border-[var(--color-border)] font-semibold"
                            : "text-[var(--color-muted-text)] hover:text-[var(--color-text)] hover:bg-[var(--color-bg)]/50 border border-transparent",
                        ]}
                      >
                        {texto}
                      </a>
                    );
                  })}
                </nav>
              </div>
            </details>
          </div>
        </div>
      </div>
    </header>

    <main id="contenido" class="contenedor py-8 md:py-12 flex-1">
      <slot />
    </main>

    <footer class="site-footer border-t border-[var(--color-border)] bg-[var(--color-surface)]/50 mt-auto">
      <div class="contenedor py-8 text-sm flex flex-col md:flex-row items-center justify-between gap-4">
        <div class="flex flex-col md:flex-row items-center gap-2 text-center md:text-left text-[var(--color-muted-text)]">
          <span class="w-2 h-2 rounded-full bg-[var(--color-accent)] inline-block shrink-0"></span>
          <span class="flex flex-col items-center md:flex-row md:items-baseline gap-1 md:gap-2">
            <span class="font-bold text-[var(--color-accent)]">wiki·dev</span>
            <span>
              <span class="block md:inline">© 2026</span>{" "}
              <span class="block md:inline">kimografico.com</span>
            </span>
          </span>
        </div>
        <div class="flex flex-wrap items-center justify-center gap-x-4 gap-y-1 text-xs text-[var(--color-muted-text)]">
          {enlacesFooter.map((enlace, i) => (
            <>
              {i > 0 && <span aria-hidden="true">·</span>}
              <a
                href={enlace.href}
                class="no-underline hover:text-[var(--color-text)]"
              >
                {enlace.texto}
              </a>
            </>
          ))}
        </div>
      </div>
    </footer>

    <!-- ASTRO: is:inline para cerrar menús desplegables details al hacer clic fuera -->
    <script is:inline>
      document.addEventListener("click", (e) => {
        const openDetails = document.querySelectorAll("details[open]");
        openDetails.forEach((details) => {
          if (!details.contains(e.target)) {
            details.removeAttribute("open");
          }
        });
      });
    </script>
  </body>
</html>
