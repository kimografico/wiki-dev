---
// Índice transversal por categoría o etiqueta (RF-06): migas, cabecera,
// salto entre valores y listado de entradas de todas las colecciones.
// Las páginas `[categoria]` y `[etiqueta]` solo resuelven el valor y sus datos.
import BaseLayout from "../../layouts/BaseLayout.astro";
import ListaEntradas from "../../components/ListaEntradas.astro";
import { nombreCategoria, nombreEtiqueta } from "../../lib/content/nombres.ts";
import type { Entrada } from "../../lib/content/entradas.ts";

interface Props {
  tipo: "categoria" | "etiqueta";
  valor: string;
  nombre: string;
  entradas: Entrada[];
  valores: readonly string[];
}

const { tipo, valor, nombre, entradas, valores } = Astro.props;

const base = import.meta.env.BASE_URL;
const esCategoria = tipo === "categoria";
const etiqueta = esCategoria ? "Categoría" : "Etiqueta";
const prefijo = esCategoria ? "" : "#";
const urlBase = esCategoria ? "categorias" : "etiquetas";
const nombreDe = esCategoria ? nombreCategoria : nombreEtiqueta;
const ariaNav = esCategoria ? "Todas las categorías" : "Todas las etiquetas";
const descripcion = esCategoria
  ? `Entradas de la categoría ${nombre} de la wiki.`
  : `Entradas etiquetadas con ${nombre} en la wiki.`;
const resumen = esCategoria
  ? "Todas las entradas de la wiki clasificadas en esta categoría."
  : "Todas las entradas de la wiki que llevan esta etiqueta.";
const vacio = esCategoria
  ? `No hay entradas en la categoría «${nombre}» todavía.`
  : `No hay entradas con la etiqueta «${nombre}» todavía.`;
---

<BaseLayout titulo={`${etiqueta}: ${nombre}`} descripcion={descripcion}>
  <div class="space-y-8">
    <nav
      aria-label="Ruta de navegación"
      class="text-xs sm:text-sm text-[var(--color-muted-text)]"
    >
      <ol class="flex items-center gap-1.5 list-none p-0 m-0">
        <li>
          <a
            href={base}
            class="no-underline text-[var(--color-muted-text)] hover:text-[var(--color-text)] transition-colors"
          >
            Inicio
          </a>
        </li>
        <li aria-hidden="true" class="text-[var(--color-border-strong)]">
          /
        </li>
        <li aria-current="page" class="font-medium text-[var(--color-text)]">
          {prefijo}
          {nombre}
        </li>
      </ol>
    </nav>

    <header class="pb-6 border-b border-[var(--color-border)]">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
        <div>
          <div class="flex items-center gap-2 mb-2">
            <span class="text-xs font-mono uppercase tracking-wider font-semibold text-[var(--color-accent-text)]">
              {etiqueta}
            </span>
          </div>
          <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-[var(--color-text)] m-0 mb-2">
            {prefijo}
            {nombre}
          </h1>
          <p class="text-base text-[var(--color-muted-text)] m-0 max-w-2xl">
            {resumen}
          </p>
        </div>

        <div class="sm:text-right shrink-0">
          <span class="text-2xl sm:text-3xl font-extrabold font-mono text-[var(--color-text)] block">
            {entradas.length}
          </span>
          <span class="text-xs text-[var(--color-muted)] font-mono">
            entradas
          </span>
        </div>
      </div>
    </header>

    <!-- Salto entre valores -->
    <nav aria-label={ariaNav}>
      <ul class="flex flex-wrap gap-1.5 list-none p-0 m-0 text-sm">
        {valores.map((item) => {
          const activo = item === valor;
          return (
            <li>
              <a
                href={`${base}${urlBase}/${item}`}
                aria-current={activo ? "page" : undefined}
                class:list={[
                  "inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full border text-xs sm:text-sm no-underline transition-colors",
                  activo
                    ? "bg-[var(--color-accent)] text-[var(--color-on-accent)] border-[var(--color-accent)] font-semibold"
                    : "bg-[var(--color-surface)] text-[var(--color-muted-text)] border-[var(--color-border)] hover:text-[var(--color-text)] hover:border-[var(--color-accent)]/60",
                ]}
              >
                {prefijo}
                {nombreDe(item)}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    <ListaEntradas entradas={entradas} vacio={vacio} />
  </div>
</BaseLayout>
