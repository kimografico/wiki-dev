---
interface Props {
  href: string;
  tipo?: "categoria" | "tag";
  conteo?: number;
}

const { href, tipo = "tag", conteo } = Astro.props;
---

<a
  href={href}
  class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full border bg-[var(--color-surface)] text-[var(--color-muted-text)] border-[var(--color-border)] text-sm no-underline transition-colors hover:text-[var(--color-text)] hover:border-[var(--color-accent)]/60 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-focus)]"
>
  {tipo === "tag" && <span class="font-mono">#</span>}
  <span>
    <slot />
  </span>
  {conteo !== undefined && (
    <span class="text-[11px] font-mono text-[var(--color-muted)]">
      {conteo}
    </span>
  )}
</a>
