---
// Bloque «Mencionado en» (backlinks), generado desde el frontmatter (RF-06).
import { getBacklinks, urlEntrada } from "../lib/content/entradas.ts";

interface Props {
  slug: string;
  coleccion: string;
}

const { slug } = Astro.props;
const backlinks = await getBacklinks(slug);
const base = import.meta.env.BASE_URL;
---

{backlinks.length > 0 && (
  <section aria-labelledby="mencionado-en" class="space-y-3">
    <div class="flex items-center gap-2 pb-2 border-b border-[var(--color-border)]">
      <h2
        id="mencionado-en"
        class="text-xs font-mono font-bold uppercase tracking-wider text-[var(--color-muted-text)] m-0"
      >
        Mencionado en
      </h2>
      <span class="text-[10px] font-mono px-1.5 py-0.2 rounded-full bg-[var(--color-bg)] text-[var(--color-muted-text)] border border-[var(--color-border)]">
        {backlinks.length}
      </span>
    </div>

    <ul class="list-none p-0 m-0 space-y-0.5">
      {backlinks.map((item) => {
        const href = urlEntrada(item.coleccion, item.slug, base);
        return (
          <li class="py-0.5">
            <a
              href={href}
              class="inline-flex items-center gap-2 text-xs sm:text-sm text-[var(--color-text)] hover:text-white no-underline transition-colors"
            >
              <span class="font-medium">{item.titulo}</span>
            </a>
          </li>
        );
      })}
    </ul>
  </section>
)}
