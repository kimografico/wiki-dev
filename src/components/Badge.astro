---
// Insignia de categoría o etiqueta. El texto es visible: el color no es el único
// portador de significado (RNF-03).
interface Props {
  tipo?: "categoria" | "tag";
}

const { tipo = "tag" } = Astro.props;
---

<span
  class="badge inline-flex items-center gap-1 px-2.5 py-1 rounded-md text-xs font-medium border transition-colors"
  data-tipo={tipo}
>
  {tipo === "tag" && <span class="text-[var(--color-muted)] font-mono">#</span>}
  <slot />
</span>
