---
// Listado genérico de entradas (componente compartido por varias features).
import type { Entrada } from "../lib/content/entradas.ts";
import EntradaItem from "./EntradaItem.astro";

interface Props {
  entradas: Entrada[];
  vacio?: string;
  compacto?: boolean;
}

const {
  entradas,
  vacio = "No hay entradas todavía.",
  compacto = false,
} = Astro.props;
---

{entradas.length === 0 ? (
  <div class="p-8 text-center rounded-xl border border-dashed border-[var(--color-border)] text-sm text-[var(--color-muted-text)] my-4">
    {vacio}
  </div>
) : (
  <ul
    class:list={[
      "lista-entradas list-none p-0 m-0",
      compacto
        ? "grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3"
        : "grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4",
    ]}
  >
    {entradas.map((entrada) => (
      <EntradaItem entrada={entrada} compacto={compacto} />
    ))}
  </ul>
)}
