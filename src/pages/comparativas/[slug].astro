---
// Ficha de comparativa (RF-04). Las secciones obligatorias (Contexto,
// Criterios, Cuándo elegir cada una, Ejemplos) las exige el validador.
import PaginaFicha from "../../features/ficha/PaginaFicha.astro";
import { getPorColeccion } from "../../lib/content/entradas.ts";

export async function getStaticPaths() {
  const comparativas = await getPorColeccion("comparativas");
  return comparativas.map((comparativa) => ({
    params: { slug: comparativa.slug },
  }));
}

const { slug } = Astro.params;
---

<PaginaFicha slug={slug ?? ""} />
