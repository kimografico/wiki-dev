---
// Índice por categoría (RF-06): entradas de TODAS las colecciones que tengan
// esta categoría. La categoría es transversal: cualquier colección del
// catálogo puede compartirla.
import IndiceTransversal from "../../features/transversales/IndiceTransversal.astro";
import { getPorCategoria } from "../../lib/content/entradas.ts";
import { CATEGORIAS } from "../../lib/content/esquemas.ts";
import { nombreCategoria } from "../../lib/content/nombres.ts";

export async function getStaticPaths() {
  return CATEGORIAS.map((categoria) => ({ params: { categoria } }));
}

// `categoria` llega por la ruta en producción y como prop en las stories.
interface Props {
  categoria?: string;
}

const categoria = Astro.props.categoria ?? Astro.params.categoria ?? "";
const entradas = (await getPorCategoria(categoria)).sort((a, b) =>
  a.titulo.localeCompare(b.titulo, "es"),
);
---

<IndiceTransversal
  tipo="categoria"
  valor={categoria}
  nombre={nombreCategoria(categoria)}
  entradas={entradas}
  valores={CATEGORIAS}
/>
