---
// Portada: accesos a las colecciones. El buscador y los accesos por categoría y
// etiqueta llegan en F2.
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPorColeccion } from "../lib/content/entradas.ts";
import ListaEntradas from "../components/ListaEntradas.astro";

const base = import.meta.env.BASE_URL;

const colecciones = [
  {
    nombre: "Glosario",
    url: `${base}glosario`,
    clave: "glosario" as const,
    descripcion: "Términos y conceptos.",
  },
  {
    nombre: "Tecnologías",
    url: `${base}tecnologias`,
    clave: "tecnologias" as const,
    descripcion: "Lenguajes, frameworks y plataformas.",
  },
  {
    nombre: "Paquetes",
    url: `${base}paquetes`,
    clave: "paquetes" as const,
    descripcion: "Dependencias y CLI de un ecosistema.",
  },
];

const resumen = await Promise.all(
  colecciones.map(async (coleccion) => ({
    ...coleccion,
    entradas: await getPorColeccion(coleccion.clave),
  })),
);
---

<BaseLayout
  titulo="Inicio"
  descripcion="Wiki estática de consulta para programadores junior: glosario, tecnologías y paquetes."
>
  <h1>wiki-dev</h1>
  <p class="prose">
    Wiki de consulta para programadores junior. Elige una sección o busca por el
    nombre de un término.
  </p>

  {resumen.map((coleccion) => (
    <section aria-labelledby={`titulo-${coleccion.clave}`}>
      <h2 id={`titulo-${coleccion.clave}`}>
        <a href={coleccion.url}>{coleccion.nombre}</a>
      </h2>
      <p class="text-muted">{coleccion.descripcion}</p>
      <ListaEntradas
        entradas={coleccion.entradas.slice(0, 6)}
        vacio="Todavía no hay entradas."
      />
      {coleccion.entradas.length > 6 && (
        <p>
          <a href={coleccion.url}>
            Ver las {coleccion.entradas.length} entradas
          </a>
        </p>
      )}
    </section>
  ))}
</BaseLayout>
