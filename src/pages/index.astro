---
// Página provisional de la Fase 0 (fundación). La portada real —buscador y
// accesos por categoría y etiqueta— llega en F2, y los layouts, en F1.
import "../styles/global.css";

// ASTRO: import.meta.env.BASE_URL resuelve el `base` del sitio (GitHub Pages
//   sirve el proyecto en /<repo>/). REACT+VITE: sería import.meta.env.BASE_URL
//   igual (Vite), o process.env.PUBLIC_URL en Create React App.
const base = import.meta.env.BASE_URL;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="icon" href={`${base}favicon.ico`} />
    <meta name="generator" content={Astro.generator} />
    <title>wiki-dev</title>
  </head>
  <body>
    <main>
      <h1>wiki-dev</h1>
      <p>Proyecto en construcción (fase F0: fundación).</p>
    </main>
  </body>
</html>
