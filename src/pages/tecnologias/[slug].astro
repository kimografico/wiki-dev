---
import FichaLayout from "../../layouts/FichaLayout.astro";
import { getPorColeccion } from "../../lib/content/entradas.ts";
import { getPaginaEntrada } from "../../lib/content/entradas.ts";

export async function getStaticPaths() {
  const tecnologias = await getPorColeccion("tecnologias");
  return tecnologias.map((tecnologia) => ({
    params: { slug: tecnologia.slug },
  }));
}

const pagina = await getPaginaEntrada(Astro.params.slug ?? "");
if (!pagina) throw new Error(`Tecnología no encontrada: ${Astro.params.slug}`);
const { Content, entrada } = pagina;
const base = import.meta.env.BASE_URL;
---

<FichaLayout
  titulo={entrada.titulo}
  resumen={entrada.resumen}
  categoria={entrada.categoria}
  tags={entrada.tags}
  slug={entrada.slug}
  coleccion={entrada.coleccion}
  urlColeccion={`${base}tecnologias`}
  nombreColeccion="Tecnologías"
>
  <Content />
</FichaLayout>
