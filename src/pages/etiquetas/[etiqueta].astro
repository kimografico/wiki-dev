---
// Índice por etiqueta (RF-06): entradas de todas las colecciones que lleven
// esta etiqueta. Las etiquetas son transversales (§7.5).
import IndiceTransversal from "../../features/transversales/IndiceTransversal.astro";
import { getPorEtiqueta } from "../../lib/content/entradas.ts";
import { ETIQUETAS } from "../../lib/content/esquemas.ts";
import { nombreEtiqueta } from "../../lib/content/nombres.ts";

export async function getStaticPaths() {
  return ETIQUETAS.map((etiqueta) => ({ params: { etiqueta } }));
}

// `etiqueta` llega por la ruta en producción y como prop en las stories.
interface Props {
  etiqueta?: string;
}

const etiqueta = Astro.props.etiqueta ?? Astro.params.etiqueta ?? "";
const entradas = (await getPorEtiqueta(etiqueta)).sort((a, b) =>
  a.titulo.localeCompare(b.titulo, "es"),
);
---

<IndiceTransversal
  tipo="etiqueta"
  valor={etiqueta}
  nombre={nombreEtiqueta(etiqueta)}
  entradas={entradas}
  valores={ETIQUETAS}
/>
