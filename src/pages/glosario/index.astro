---
import BaseLayout from "../../layouts/BaseLayout.astro";
import IndiceAlfabetico from "../../features/glosario/IndiceAlfabetico.astro";
import { getPorColeccion } from "../../lib/content/entradas.ts";

const terminos = await getPorColeccion("glosario");
const base = import.meta.env.BASE_URL;
---

<BaseLayout
  titulo="Glosario"
  descripcion="Términos y conceptos explicados para programadores junior."
>
  <div class="space-y-8">
    <nav aria-label="Ruta de navegación" class="text-xs sm:text-sm text-[var(--color-muted-text)]">
      <ol class="flex items-center gap-1.5 list-none p-0 m-0">
        <li>
          <a href={base} class="no-underline text-[var(--color-muted-text)] hover:text-[var(--color-text)] transition-colors">
            Inicio
          </a>
        </li>
        <li aria-hidden="true" class="text-[var(--color-border-strong)]">/</li>
        <li aria-current="page" class="font-medium text-[var(--color-text)]">
          Glosario
        </li>
      </ol>
    </nav>

    <!-- Header sin recuadro -->
    <header class="pb-6 border-b border-[var(--color-border)]">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
        <div>
          <div class="flex items-center gap-2 mb-2">
            <span class="text-xs font-mono uppercase tracking-wider font-semibold text-[var(--color-accent-text)]">
              Colección Glosario
            </span>
          </div>
          <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-[var(--color-text)] m-0 mb-2">
            Glosario de Desarrollo Web
          </h1>
          <p class="text-base text-[var(--color-muted-text)] m-0 max-w-2xl">
            Definiciones precisas con explicación, ejemplos ejecutables, trampas comunes y relaciones conceptuales.
          </p>
        </div>

        <div class="sm:text-right shrink-0">
          <span class="text-2xl sm:text-3xl font-extrabold font-mono text-[var(--color-text)] block">
            {terminos.length}
          </span>
          <span class="text-xs text-[var(--color-muted)] font-mono">términos definidos</span>
        </div>
      </div>
    </header>

    <IndiceAlfabetico />
  </div>
</BaseLayout>
