---
import FichaLayout from "../../layouts/FichaLayout.astro";
import { getTodosLosTerminos } from "../../lib/content/glosario.ts";
import { getPaginaEntrada } from "../../lib/content/entradas.ts";

// ASTRO: getStaticPaths genera una página por término en build.
// REACT+VITE: generarías las rutas desde el contenido (React Router / SSG).
export async function getStaticPaths() {
  const terminos = await getTodosLosTerminos();
  return terminos.map((termino) => ({ params: { slug: termino.slug } }));
}

const pagina = await getPaginaEntrada(Astro.params.slug ?? "");
if (!pagina) throw new Error(`Término no encontrado: ${Astro.params.slug}`);
const { Content, entrada } = pagina;
const base = import.meta.env.BASE_URL;
---

<FichaLayout
  titulo={entrada.titulo}
  resumen={entrada.resumen}
  categoria={entrada.categoria}
  tags={entrada.tags}
  slug={entrada.slug}
  coleccion={entrada.coleccion}
  urlColeccion={`${base}glosario`}
  nombreColeccion="Glosario"
>
  <Content />
</FichaLayout>
