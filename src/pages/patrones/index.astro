---
// Índice de patrones: problemas recurrentes con su solución, estructura y
// ejemplos (§7.4).
import IndiceColeccion from "../../features/colecciones/IndiceColeccion.astro";
import { getPorColeccion } from "../../lib/content/entradas.ts";

const patrones = (await getPorColeccion("patrones")).sort((a, b) =>
  a.titulo.localeCompare(b.titulo, "es"),
);
---

<IndiceColeccion
  coleccion="patrones"
  encabezado="Patrones"
  descripcion="Patrones y soluciones a problemas recurrentes de diseño con estructura y ejemplos."
  resumen="Problemas recurrentes con su solución, la estructura que la implementa, un ejemplo y cuándo merece la pena usarla."
  contador={patrones.length}
  etiquetaContador="patrones"
  entradas={patrones}
  vacio="Todavía no hay patrones publicados."
/>
