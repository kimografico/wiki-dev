---
// Ficha de testing: Qué es · Para qué sirve · Tipos de prueba · Ejemplo.
// Alternativas es opcional (MANUAL.md).
import PaginaFicha from "../../features/ficha/PaginaFicha.astro";
import { getPorColeccion } from "../../lib/content/entradas.ts";

export async function getStaticPaths() {
  const entradas = await getPorColeccion("testing");
  return entradas.map((entrada) => ({ params: { slug: entrada.slug } }));
}

const { slug } = Astro.params;
---

<PaginaFicha slug={slug ?? ""} />
