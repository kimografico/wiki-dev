{
  "name": "wiki-dev",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 0.0.0.0 --port 3000",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "validate": "node scripts/validate-content.ts",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{astro,js,mjs,cjs,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@astrojs/react": "7.0.1",
    "astro": "7.3.8",
    "mermaid": "11.17.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/markdown-remark": "7.3.2",
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@vitest/coverage-v8": "5.0.4",
    "astro-mermaid": "2.1.0",
    "astrobook": "0.13.3",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-astro": "3.2.1",
    "gray-matter": "4.0.3",
    "husky": "9.1.7",
    "lighthouse": "13.5.0",
    "lint-staged": "17.6.0",
    "pagefind": "1.5.2",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4",
    "zod": "4.6.7"
  }
}
